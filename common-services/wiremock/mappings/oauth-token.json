{
  "request": {
    "method": "POST",
    "url": "/oauth/token",
    "headers": {
      "Content-Type": {
        "contains": "application/x-www-form-urlencoded"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "access_token": "wiremock-test-access-token",
      "token_type": "Bearer",
      "expires_in": 3600
    }
  }
}

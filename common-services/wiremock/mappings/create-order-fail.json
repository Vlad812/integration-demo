{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/orders",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.instrument_ticker == 'FAIL')]"
      }
    ],
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "invalid_order",
      "message": "Invalid instrument ticker"
    }
  }
}

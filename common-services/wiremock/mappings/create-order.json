{
  "request": {
    "method": "POST",
    "url": "/v1/orders",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 202,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "order_id": "ord_{{randomValue type='UUID'}}",
      "status": "PENDING_ROUTING",
      "created_at": "{{now format='yyyy-MM-dd'}}T{{now format='HH:mm:ss'}}Z",
      "expected_commission": "1.50"
    },
    "transformers": ["response-template"],
    "fixedDelayMilliseconds": 1500
  }
}

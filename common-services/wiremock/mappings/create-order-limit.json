{
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/v1/orders",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.instrument_ticker == 'LIMIT')]"
      }
    ],
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 429,
    "headers": {
      "Content-Type": "application/json",
      "Retry-After": "5"
    },
    "jsonBody": {
      "error": "rate_limit_exceeded",
      "message": "Too many requests"
    }
  }
}
